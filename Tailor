<div class="field full"><label for="serviceType">WHAT DO YOU NEED?</label>
<select id="serviceType" required>
<option value="">Choose a service</option>
<option>Custom stitching</option><option>Blouse stitching</option>
<option>Alterations</option><option>Daily wear</option>
<option>Occasion wear</option><option>Other / Not sure yet</option>
</select></div>
