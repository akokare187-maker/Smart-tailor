<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f7f3ed;--dark:#28251f;--muted:#777168;--accent:#a36f50;--line:#e6ded2;--white:#fffdfa;--green:#287b55}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{background:var(--bg);color:var(--dark);font-family:"DM Sans",sans-serif;line-height:1.65}
a{text-decoration:none;color:inherit}
button,input,select,textarea{font:inherit}
.wrap{width:min(1160px,90%);margin:auto}
.topline{background:var(--dark);color:white;text-align:center;padding:8px;font-size:11px;letter-spacing:1.5px}
header{position:sticky;top:0;z-index:20;background:#f7f3edee;backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav{height:78px;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:11px}
.mark{width:39px;height:39px;border:1px solid var(--accent);border-radius:50%;display:grid;place-items:center;color:var(--accent);font:21px "Playfair Display",serif}
.brand-name{font:600 20px "Playfair Display",serif}
.brand-name small{display:block;font:600 9px "DM Sans";letter-spacing:2px;color:var(--muted)}
.navlinks{display:flex;gap:27px;list-style:none;font-size:12px;font-weight:600}
.navlinks a:hover{color:var(--accent)}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 20px;background:var(--dark);color:white;border:1px solid var(--dark);font-size:12px;font-weight:700;cursor:pointer;transition:.2s}
.btn:hover{background:var(--accent);border-color:var(--accent)}
.btn-light{background:transparent;color:var(--dark);border-color:#cfc4b6}
.menu{display:none;background:none;border:0;font-size:25px;cursor:pointer}
.hero{padding:76px 0 82px}
.hero-grid{display:grid;grid-template-columns:1fr .92fr;align-items:center;gap:65px}
.kicker{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--accent);font-weight:700;margin-bottom:19px}
h1,h2,h3{font-family:"Playfair Display",serif;font-weight:500;line-height:1.15}
h1{font-size:clamp(45px,6vw,76px);letter-spacing:-1.8px}
h1 em{color:var(--accent)}
.hero-copy{max-width:470px;color:var(--muted);font-size:14px;margin:24px 0 29px}
.actions{display:flex;gap:12px;flex-wrap:wrap}
.hero-meta{margin-top:35px;padding-top:20px;border-top:1px solid var(--line);font-size:11px;color:var(--muted)}
.hero-photo{position:relative;padding:0 0 24px 24px}
.hero-photo:before{content:"";position:absolute;left:0;bottom:0;width:75%;height:75%;background:#e9dfd1;z-index:-1}
.hero-photo img{width:100%;height:490px;object-fit:cover}
.photo-note{position:absolute;right:-18px;bottom:48px;background:white;padding:16px 20px;box-shadow:0 10px 35px #30251915}
.photo-note strong{display:block;font:19px "Playfair Display",serif}
.photo-note span{font-size:10px;color:var(--muted)}
.intro-strip{border-block:1px solid var(--line);padding:21px 0}
.strip-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;text-align:center}
.strip-grid div{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase}
.strip-grid span{color:var(--accent);margin-right:8px}
section{padding:88px 0}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:68px;align-items:center}
.about-photo img{width:100%;height:440px;object-fit:cover}
.about-copy h2{font-size:clamp(36px,4vw,49px);margin-bottom:20px}
.about-copy p{font-size:13px;color:var(--muted);margin-bottom:16px}
.signature{font:italic 25px "Playfair Display",serif;color:var(--accent);margin-top:22px}
.signature small{display:block;font:600 9px "DM Sans";letter-spacing:2px;color:var(--muted)}
.services{background:#eee8df}
.section-head{max-width:620px;margin-bottom:38px}
.section-head h2{font-size:clamp(35px,4.5vw,52px)}
.section-head p{color:var(--muted);font-size:13px;margin-top:15px}
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.service{background:var(--white);padding:27px 25px;min-height:190px;border:1px solid #e9e1d6;transition:.2s}
.service:hover{transform:translateY(-4px);box-shadow:0 14px 35px #3025190c}
.service-no{font:italic 16px "Playfair Display";color:var(--accent)}
.service h3{font-size:23px;margin:17px 0 10px}
.service p{font-size:12px;color:var(--muted)}
.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:35px}
.step{border-top:1px solid var(--accent);padding-top:19px}
.step b{font:italic 17px "Playfair Display";color:var(--accent)}
.step h3{font-size:23px;margin:13px 0 9px}
.step p{font-size:12px;color:var(--muted)}
.quote-band{background:#59634d;color:#fffaf1;padding:65px 0;text-align:center}
.quote-band p{font:italic clamp(25px,4vw,39px) "Playfair Display";max-width:800px;margin:auto}
.quote-band span{display:block;font-size:10px;letter-spacing:2px;margin-top:19px;color:#e2d7c8}
.contact-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:65px;align-items:start}
.contact-copy h2{font-size:46px;margin-bottom:17px}
.contact-copy>p{font-size:13px;color:var(--muted);margin-bottom:25px}
.contact-detail{padding:15px 0;border-top:1px solid var(--line)}
.contact-detail strong{display:block;font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:var(--accent)}
.contact-detail span{font-size:13px}
.form-card{background:var(--white);border:1px solid var(--line);padding:30px}
.form-card h3{font-size:27px;margin-bottom:7px}
.form-card>p{font-size:12px;color:var(--muted);margin-bottom:23px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.field{display:flex;flex-direction:column;gap:6px}
.field.full{grid-column:1/-1}
label{font-size:10px;font-weight:700;letter-spacing:.7px}
input,select,textarea{width:100%;border:1px solid var(--line);background:white;padding:12px;color:var(--dark);outline:none;font-size:12px}
input:focus,select:focus,textarea:focus{border-color:var(--accent)}
textarea{min-height:100px;resize:vertical}
.form-card button{margin-top:17px;width:100%}
.form-note{font-size:10px;color:var(--muted);margin-top:12px}
footer{background:var(--dark);color:#f6f0e7;padding:35px 0}
.footer-row{display:flex;justify-content:space-between;align-items:center;gap:20px}
.footer-brand{font:22px "Playfair Display"}
.footer-brand small{display:block;font:9px "DM Sans";letter-spacing:2px;color:#c9b9a7}
footer p{font-size:10px;color:#c9bfb3}
.whatsapp{position:fixed;right:20px;bottom:20px;z-index:15;background:var(--green);color:white;padding:13px 17px;border-radius:30px;font-size:12px;font-weight:700;box-shadow:0 6px 20px #0002}
@media(max-width:800px){
.navlinks{display:none;position:absolute;top:78px;left:0;right:0;background:var(--bg);padding:22px 5%;border-bottom:1px solid var(--line);flex-direction:column;gap:19px}
.navlinks.open{display:flex}.menu{display:block}.nav-cta{display:none}
.hero{padding:53px 0 65px}.hero-grid,.about-grid,.contact-grid{grid-template-columns:1fr;gap:35px}
.hero-photo{max-width:580px}.hero-photo img{height:390px}
section{padding:68px 0}.about-photo{order:2}.about-photo img{height:350px}
.services-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:520px){
.hero-grid{gap:30px}h1{font-size:49px}.hero-photo img{height:330px}
.strip-grid,.services-grid,.process-grid,.form-grid{grid-template-columns:1fr}
.strip-grid{gap:12px}.field.full{grid-column:auto}
.service{min-height:auto}.footer-row{align-items:flex-start;flex-direction:column}
.form-card{padding:22px}
}
</style>
</head>
